#include <stdio.h>

int main(){
    float saldo = 0;
    int opcao = 0;
    
    while(opcao != 4){
        
        printf("\n1 - Adicionar R$ 0,50\n");
        printf("2 - Adicionar R$ 1,00\n");
        printf("3 - Adicionar R$ 2,00\n");
        printf("4 - Parar\n");
        
        printf("Escolha uma opção.\n");
        scanf("%d", saldo);
        
        switch(opcao){
            case 1:
                saldo = saldo + 0.50;
                break;
            case 2:
                saldo = saldo + 1.00;
                break;
            case 3:
                saldo = saldo + 2.00;
                break;
            case 4:
                break;
            default:
                printf("Opção Invalida!\n");
        }
    printf("\nTotal acumulado: R$ %.2f\n", saldo);
    
    return 0;
    }
}
